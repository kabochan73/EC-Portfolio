# ── サーバー専用（NEXT_PUBLIC_ が付かない = ブラウザに渡らない）──────────
# apiFetch（Server Component / Route Handler）の向き先。コンテナ名で解決
API_URL=http://backend:8080

# /media プロキシ（app/media/[...key]/route.ts）が S3 互換バケットから画像を読む資格情報。
# ローカルは MinIO。backend/.env の AWS_* と資格情報自体は同じ（ecp / ecpsecret）
BUCKET_ENDPOINT=http://minio:9000
BUCKET_ACCESS_KEY_ID=ecp
BUCKET_SECRET_ACCESS_KEY=ecpsecret
BUCKET_NAME=ec-portfolio-media
BUCKET_REGION=us-east-1

# ── クライアント可（ブラウザに埋め込まれる）────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Stripe Payment Element の初期化（docs/09）。未入手なら空でよい
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
